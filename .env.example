# Optional: enables a real structured scene provider in a server-capable deployment.
# The browser demo intentionally uses polished local fallbacks when this is unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Room for a complete structured chapter, its scene beats, and its closing handoff.
STORYVERSE_STORY_MAX_OUTPUT_TOKENS=6000
# Optional image pipeline configuration. Leave OPENAI_API_KEY unset for bundled cinematic fallbacks.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional on-demand story trailer generation. The server sends an original,
# chapter-aware brief to Sora and stores the finished MP4 in the configured
# local directory or Databricks Volume; this is never requested automatically.
OPENAI_VIDEO_MODEL=sora-2
STORYVERSE_TRAILER_SECONDS=8
STORYVERSE_TRAILER_SIZE=1280x720
STORYVERSE_TRAILER_TIMEOUT_MS=120000
# Dedicated text-to-speech model. It reads the saved chapter/POV text verbatim.
OPENAI_NARRATION_MODEL=gpt-4o-mini-tts
# Reserved for future conversational audio; not used for narration or BGM.
OPENAI_AUDIO_MODEL=gpt-audio
STORYVERSE_IMAGE_PROVIDER=
STORYVERSE_IMAGE_TIMEOUT_MS=180000
STORYVERSE_IMAGE_SIZE=1024x1024
STORYVERSE_IMAGE_QUALITY=medium
STORYVERSE_NARRATION_TIMEOUT_MS=120000
# Maximum wait for a proposal-only current-chapter AI Story Director pass.
STORYVERSE_DIRECTOR_TIMEOUT_MS=45000

# Persistence. Leave DATABASE_URL blank to keep the local SQLite fallback.
# For PostgreSQL, DATABASE_URL takes precedence over the individual PG* values.
# Example local Docker value: postgresql://storyverse:storyverse@localhost:5432/storyverse
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Set `require` for Lakebase/production TLS. Leave blank for a local Postgres
# server unless it is configured with TLS.
PGSSLMODE=
# Keep TLS certificate validation enabled unless a local test certificate is used.
PGSSL_REJECT_UNAUTHORIZED=true
PGAPPNAME=storyverse
# Conservative defaults for concurrent request traffic; tune from observed pool metrics.
STORYVERSE_PG_POOL_MAX=10
STORYVERSE_PG_IDLE_TIMEOUT_MS=30000
STORYVERSE_PG_CONNECT_TIMEOUT_MS=10000

# Generated image and narration asset storage.
# `local` stores assets under ./data. `databricks-volume` uses the Databricks
# Files API against the Unity Catalog Volume below.
STORYVERSE_ASSET_STORAGE=local
# Full workspace URL. StoryVerse requests workspace-scoped OAuth tokens from
# <DATABRICKS_HOST>/oidc/v1/token; DATABRICKS_ACCOUNT_ID is not needed for the
# Unity Catalog Volume Files API.
DATABRICKS_HOST=
# Preferred production authentication for databricks-volume: a Databricks
# service principal's OAuth client ID and secret. Set both through managed
# secrets only (never source control or browser-visible configuration).
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Compatibility fallback for a short-lived local bearer token or PAT. Configure
# this OR the client-ID/client-secret pair, not both; production should use M2M.
DATABRICKS_TOKEN=
# Example: /Volumes/<catalog>/<schema>/<volume>/storyverse
DATABRICKS_VOLUME_PATH=

# Local Docker uses 8787. Databricks Apps supplies PORT automatically.
PORT=8787
